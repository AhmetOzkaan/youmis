---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/HomeCTA.astro'
import Features from '../components/blocks/features/FeatureCards.astro'
import Testimonial from '../components/blocks/testimonials/BasicDark.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Content
// - Testimonial background
import testimonialBackground from '../assets/testimonial-bg.png'
// - SEO
const SEO = {
	title: "youMIS? | Geleceğini MISleme!",
	description:
		'youMIS?' // güncellenecek
}

// Custom testimonials (if you want to override defaults)
const testimonials = [
	{
		blockquote: "YBS okumak birçok kapı açıyor ama hangisinden gireceğimi bilemiyordum. youMIS bana hangi alanlara daha yatkın olduğumu gösterdi. Şimdi veri bilimi yolundayım.",
		figcaption: "Ahmet Yılmaz",
		cite: "YBS Mezunu"
	},
	{
		blockquote: "Test kısa ve basit ama analizi çok doğru. İlk defa bu kadar kişiselleştirilmiş bir öneri listesiyle karşılaştım.",
		figcaption: "Ayşe Kaya",
		cite: "Öğrenci"
	},
	{
		blockquote: "Test sayfasının tasarımı çok dikkat çekiciydi bu da testi benim için daha çekici hale getirdi.",
		figcaption: "Mehmet Demir",
		cite: "Üniversite Öğrencisi"
	},
	{
		blockquote: "Ben bölümde okurken bu platform olsaydı her şey çok daha kolay olurdu. Yeni mezunlar için harika bir fırsat.",
		figcaption: "Zeynep Şahin",
		cite: "Yeni Mezun"
	}
];
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero />
	<Features />
	<Testimonial testimonials={testimonials} bg={testimonialBackground} bgPosition="right" />
	<CTA />
</Layout>
