---
// Components
import Layout from '../layouts/Layout.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'

// Content
// - SEO
const SEO = {
	title: 'youMIS? | Bize Ulaşın',
	description:
		'YouMIS ekibiyle iletişime geçin. Sorularınızı yanıtlamak ve geri bildirimlerinize değer vermek için buradayız.'
}
// - Page Header
const header = {
	title: 'Bize <strong>Ulaşın!</strong>',
	text: '"YouMIS?" ekibi olarak sizinle iletişim kurmak bizim için çok önemli. Sorularınızı yanıtlamak, geri bildirimlerinizi değerlendirmek ve en iyi hizmeti sunmak için buradayız.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	
	<div class="bg-neutral-50 dark:bg-neutral-950/80 pb-16 pt-8">
		<div class="container mx-auto px-4">
			<div class="max-w-3xl mx-auto text-center space-y-8">
				<div class="space-y-4">
					<h2 class="text-2xl font-semibold text-neutral-900 dark:text-white">İletişim</h2>
					<p class="text-lg text-neutral-600 dark:text-neutral-400">
						<a href="mailto:youmis.ybu@gmail.com" class="text-primary-600 hover:text-primary-700">youmis.ybu@gmail.com</a>
					</p>
				</div>

				<div class="space-y-4">
					<h2 class="text-2xl font-semibold text-neutral-900 dark:text-white">Sosyal Medya</h2>
					<div class="space-y-2">
						<p class="text-lg text-neutral-600 dark:text-neutral-400">
							Instagram: <a href="https://instagram.com/youmisofficial" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">@youmisofficial</a>
						</p>
						<p class="text-lg text-neutral-600 dark:text-neutral-400">
							X: <a href="https://twitter.com/youmisofficial" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">@youmisofficial</a>
						</p>
					</div>
				</div>

				<div class="mt-12">
					<p class="text-lg text-neutral-600 dark:text-neutral-400">
						Fikirleriniz bizim için değerlidir. Geri bildirimleriniz platformumuzu geliştirmemize yardımcı olacaktır. Bizimle iletişime geçin ve geleceğin kariyer yollarını birlikte şekillendirelim!
					</p>
				</div>
			</div>
		</div>
	</div>
</Layout>
