---
// Courses Index Page
// ------------
// Description: The courses index page.

// Components
// - Layout
import Layout from '../../layouts/Layout.astro'
// - UI
import Hero from '../../components/blocks/hero/PageHeader.astro'

// Data
import { getCollection } from 'astro:content'

// Content
// - SEO
const SEO = {
    title: 'youMIS? | Yönetim Bilişim Sistemleri Öğrencileri için Kurslar',
    description:
        "Yönetim Bilişim Sistemleri öğrencileri için özel olarak tasarlanmış kapsamlı kurslara ve öğrenme materyallerine erişin. Özel olarak seçilmiş eğitim içeriğimizle bilgi ve becerilerinizi geliştirin."
}
// - Page Header
const header = {
    title: '<strong>youMIS?</strong> Kursları',
    subtitle: 'Kendi Hızınızda Öğrenin',
    text: 'YBS öğrencilerinin temel kavramları, teknolojileri ve endüstri uygulamalarını öğrenmelerine yardımcı olacak kapsamlı öğrenme kaynakları.'
}

const allCourses = await getCollection('courses')
---
<Layout title={SEO.title} description={SEO.description}>
    <Hero title={header.title} subtitle={header.subtitle} text={header.text} />
    
    <section class="py-16 px-5 md:px-10">
        <div class="container mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    allCourses.map((course) => (
                        <div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg overflow-hidden shadow-lg transition-all hover:shadow-xl">
                            <div class="relative">
                                <img 
                                    src={course.data.image} 
                                    alt={course.data.title}
                                    class="w-full h-48 object-cover" 
                                />
                            </div>
                            <div class="p-6">
                                <h3 class="text-xl font-bold mb-2">
                                    <a href={`/courses/${course.id}`} class="text-neutral-900 dark:text-neutral-100 hover:underline">
                                        {course.data.title}
                                    </a>
                                </h3>
                                <p class="text-neutral-700 dark:text-neutral-200 mb-4">
                                    {course.data.description}
                                </p>
                                <div class="flex justify-end items-center">
                                    <a 
                                        href={`/courses/${course.id}`}
                                        class="px-4 py-2 bg-primary-600 hover:bg-primary-700 dark:bg-primary-500 dark:hover:bg-primary-400 text-white rounded-md transition-colors"
                                    >
                                        Kursa Göz At
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
