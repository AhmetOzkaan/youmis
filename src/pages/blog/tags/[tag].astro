---
// Blog Tag Page
// ------------
// Description: The blog tag page.

// Components
// - Layout
import Layout from '../../../layouts/Layout.astro'
// - UI
import Hero from '../../../components/blocks/hero/PageHeader.astro'
import BlogPosts from '../../../components/blocks/blog/BlogPosts.astro'

// Data
import { getCollection } from 'astro:content'
export async function getStaticPaths() {
	const allPosts = await getCollection('blog')
	const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())]

	return uniqueTags.map((tag) => {
		const filteredPosts = allPosts.filter((post) => post.data.tags.includes(tag))
		return {
			params: { tag },
			props: { posts: filteredPosts }
		}
	})
}
const { tag } = Astro.params
const { posts } = Astro.props

// Content
// - SEO
const SEO = {
	title: `youMIS? | "${tag}" etiketli gönderiler`,
	description:
		"youMIS?'in uzaktan ekip işbirliğinizi ve üretkenliğinizi artırmak için tasarlanmış en son içgörülerini ve güncellemelerini keşfedin."
}

// - Page Header
const header = {
	title: `youMIS? <br><strong>${tag}</strong> etiketli gönderiler`,
	text: `youMIS?'in en son içgörüleri ve gelişmeleriyle güncel kalın.`
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<BlogPosts data={posts} />
</Layout>
