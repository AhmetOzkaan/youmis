---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/1.png'
import feature02 from '../../../assets/cards/2.png'
import feature03 from '../../../assets/cards/3.png'
import feature04 from '../../../assets/cards/4.png'
import feature05 from '../../../assets/cards/5.png'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty"><strong>youMIS</strong> ile potansiyelinizi keşfedin!</h2>
			<p class="pb-0 text-lg">
				youMIS, Yönetim Bilişim Sistemleri öğrencileri için özel olarak tasarlanmış bir kariyer rehberliği ve kişisel gelişim platformudur.
				Araçlarımız, yeteneklerinizi belirlemenize, uygun kariyer yollarını önermenize ve büyümenizi destekleyecek kaynaklar sağlamanıza yardımcı olur.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title="Kişiselleştirilmiş Kariyer Analizi"
				subtitle="MIS alanındaki belirli kariyer yollarıyla uyumlu benzersiz becerilerinizi, güçlü yönlerinizi ve tercihlerinizi keşfetmek için kapsamlı değerlendirmemize katılın."
				image={feature01}
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Kariyer Yolu Önerileri"
				subtitle="Değerlendirme sonuçlarınıza göre uyarlanmış kariyer önerileri alın, böylece başarılı olacağınız yollara odaklanmanıza yardımcı olur."
				image={feature02}
			/>
			<Card
				title="Beceri Geliştirme Kaynakları"
				subtitle="Önerilen kariyer yollarınız için gereken belirli becerileri geliştirmek üzere tasarlanmış, özenle seçilmiş öğrenme materyallerine ve kurslara erişin."
				image={feature03}
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Sektör İçgörüleri"
				subtitle="Farklı MIS kariyer uzmanlık alanlarındaki en son trendler, gereksinimler ve fırsatlar hakkında bilgi sahibi olun."
				image={feature04}
			/>
			<Card
				title="Kişisel Gelişim Takibi"
				subtitle="İdeal kariyeriniz için gereken becerileri geliştirirken ilerlemenizi izleyin, hedefler belirleyin ve başarıları kutlayın."
				image={feature05}
			/>
		</Col>
	</Row>
</Section>
