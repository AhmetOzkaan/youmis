---
// Basic Dark Call To Action section
// ------------
// Description: A centered call to action section that contains: a title, text, background image, notification and a button.

// Components
// - Layout
import Section from '../../ui/Section.astro'

// - UI
import CTA from '../../ui/CTA.astro'
import Button from '../../ui/Button.astro'
import ChipNotification from '../../ui/ChipNotification.astro'
import { Image } from 'astro:assets'

// Content
import ctaImage from '../../../assets/cta-dark-bg.webp'
import badge from '../../../assets/badge.svg'
---
<Section classes="min-h-screen" fullWidth>
	<CTA
		title="İdeal MIS Kariyer Yolunuzu Keşfedin!"
		text="Hangi MIS uzmanlık alanının becerileriniz ve ilgi alanlarınızla uyumlu olduğunu belirlemek için kapsamlı değerlendirmemize katılın. Testi sadece birkaç dakika içinde tamamlayın ve sadece size özel kişiselleştirilmiş kariyer önerileri alın."
		mode="dark"
		bg={ctaImage}
		classes="min-h-screen flex flex-col items-center justify-center w-full"
	>
		<ChipNotification radius="rounded-full" classes="mb-6 box">
			<Image src={badge} alt="Hızlı Değerlendirme" class="h-12 w-12" slot="button" />
			<span class="hidden md:block">Sadece 5 dakika sürer.</span>
		</ChipNotification>
		<Button size="2xl" style="primary" link='/career-test'> Kariyer Testini Çöz </Button>
	</CTA>
</Section>
