---
// Home page CTA Section
// ------------
// Description: A centered call to action section that contains: a title, text, a user review snippet, a button and a image.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Button from '../../ui/Button.astro'

---

<Section id="intro" padding="top" classes="bg-neutral-50 dark:bg-neutral-900 min-h-screen flex items-center">
	<Row>
		<Col span="2" />
		<Col span="8" align="center">
			<h1 class="text-7xl">Geleceği <strong>MIS</strong> gibi Yakala!</h1>


			<p class="pb-0 text-lg">
				Yönetim Bilişim Sistemleri öğrencileri için tasarlanmış, yapay zeka destekli kariyer rehberiniz!
				<br>
				Kendi güçlü yönlerinizi keşfedin, youMIS ile yolculuğunuza hemen başlayın!
			</p>
			<Button size="lg" link="/career-test">Kariyer Testini Çöz</Button>
		</Col>
		<Col span="2" />
		<Col span="2" />
		<Col span="8">
		</Col>
		<Col span="2" />
	</Row>
</Section>
